					const result = await deleteMessageApi(messageId.value)

					// 兼容两种响应格式
					if (result.success || result.code === 200) {
						uni.hideLoading()

						// 先显示成功提示
						uni.showToast({
							title: '删除成功',
							icon: 'success',
