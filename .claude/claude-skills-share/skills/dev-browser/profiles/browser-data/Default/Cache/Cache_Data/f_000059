const formatPrice = (price) => {
  if (!price) return '--'
  return parseFloat(price).toFixed(2)
}

const formatChange = (change) => {
  if (!change) return '0.00'
  const num = parseFloat(change)
  return num >= 0 ? '+' + num.toFixed(2) : num.toFixed(2)
}

const formatChangePct = (pct) => {
  if (!pct) return '0.00%'
