# 腾讯云生产环境配置
NODE_ENV=production

# API基础配置 - 腾讯云服务器
VITE_APP_API_BASE_URL=https://aity88.online:8443/api
VITE_APP_API_TIMEOUT=30000

# 上传配置
VITE_APP_UPLOAD_MAX_SIZE=10485760
VITE_APP_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# 功能开关
VITE_APP_ENABLE_AI_OPTIMIZE=true
VITE_APP_ENABLE_STOCK_TAG=true
VITE_APP_ENABLE_ATTACHMENT=true

# 调试配置
VITE_APP_DEBUG=false
VITE_APP_LOG_LEVEL=error

# 生产存储配置
VITE_APP_STORAGE_PREFIX=aity_vip_prod_
