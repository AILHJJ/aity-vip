# 开发环境配置
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=投研图灵室
DB_USER=root
DB_PASSWORD=

# JWT配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS配置
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# HTTPS配置（生产环境使用）
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
