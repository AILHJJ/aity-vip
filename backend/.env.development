# 开发环境配置
# 此配置用于本地开发，连接测试数据库
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
# DB_NAME 可选，不指定时根据 DB_ENV 自动选择
# DB_ENV=test 自动连接测试库(投研图灵室_test)
# DB_ENV=production 自动连接生产库(投研图灵室)
DB_USER=fl
DB_PASSWORD=fl10b312
DB_ENV=test

# JWT配置
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS配置（开发环境允许本地访问）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://192.168.2.140:3001

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# HTTPS配置（生产环境使用）
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
