# ============================================
# 开发环境配置
# 此配置用于本地开发，连接测试数据库
# 使用方式: npm run dev
# ============================================

# 环境标识
NODE_ENV=development

# 服务器配置
HOST=0.0.0.0
PORT=3001

# ============================================
# 数据库配置
# ============================================
DB_HOST=124.221.119.134
DB_PORT=3306
DB_USER=投研图灵室
DB_PASSWORD=fl10b312

# 数据库名称
DB_NAME=投研图灵室

# 数据库环境: test=测试库(投研图灵室_test)
DB_ENV=production

# ============================================
# JWT配置
# ============================================
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ============================================
# CORS配置（开发环境允许本地访问）
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080,http://localhost:3000,http://192.168.2.140:5173,http://192.168.2.140:5174,http://192.168.2.140:5175,http://192.168.2.140:3001

# ============================================
# 文件上传配置
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ============================================
# HTTPS配置（开发环境不启用）
# ============================================
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
