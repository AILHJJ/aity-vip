# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=投研图灵室
DB_USER=root
DB_PASSWORD=your_database_password

# JWT配置
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=24h

# 服务器配置
PORT=3000

# 文件上传配置
UPLOAD_PATH=./uploads
