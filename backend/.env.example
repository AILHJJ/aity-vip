# ============================================
# AITY VIP 后端环境配置模板
# ============================================
# 复制此文件为 .env 并修改相应配置
#
# 环境说明：
# - 开发环境：NODE_ENV=development, DB_ENV=test
# - 生产环境：NODE_ENV=production, DB_ENV=production
# ============================================

# 服务器配置
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
# 数据库用户名和密码
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# 数据库环境选择：
# - test: 测试数据库 (投研图灵室_test)
# - production: 生产数据库 (投研图灵室)
DB_ENV=test

# JWT配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS配置（多个域名用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# HTTPS配置（生产环境使用）
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# 邮件提醒配置（测试期推荐 163 SMTP）
# 默认关闭真实发送；启用前必须使用邮箱客户端授权码，不要填写邮箱登录密码。
MAIL_ENABLED=false
MAIL_DRY_RUN=true
MAIL_AUTO_PROCESS=true
MAIL_NOTIFY_ADMINS=false
MAIL_NOTIFY_COOLDOWN_MINUTES=10
BUSINESS_TIMEZONE_OFFSET_MINUTES=480
NOTIFICATION_OUTBOX_AUTO_SYNC=true
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lhdms88@163.com
SMTP_PASS=your_163_smtp_authorization_code
MAIL_FROM_NAME=AITY投研提醒
MAIL_FROM=lhdms88@163.com
