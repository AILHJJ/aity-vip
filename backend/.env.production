# 生产环境配置
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=投研图灵室
DB_USER=root
DB_PASSWORD=your-production-password

# JWT配置
JWT_SECRET=your-production-secret-key-change-this
JWT_EXPIRES_IN=24h

# CORS配置（允许HTTPS域名和开发服务器）
# 注意：微信小程序请求不带Origin头，所以代码中需要特殊处理
ALLOWED_ORIGINS=https://aity88.online:8443,https://aity88.online,http://124.221.119.134:8080,http://localhost:5173,http://localhost:3000

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# HTTPS配置
HTTPS_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/aity88.online.crt
SSL_KEY_PATH=/etc/nginx/ssl/aity88.online.key
