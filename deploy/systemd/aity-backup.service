[Unit]
Description=AITY protected database and application backup
After=mysql.service
Wants=mysql.service

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/python3 /root/aity-migration/runtime/backup-live-config.py --daily
TimeoutStartSec=20min
